  "runtime": {
    "applicationName": "microsoft-intune",
    "environment": "production",
    "eventCategory": "application-security",
    "eventType": "intune_device_compliance",
    "eventAction": "intune.compliance",
    "eventResult": "unknown",
    "transforms": [
      "if .sourceKind == \"intune-device-compliance\" && .complianceState != null && .complianceState != \"compliant\" { .selected = \"true\" } else { .selected = \"false\" }",
      ".action = concat(\"device.compliance.\", coalesce(.complianceState, \"unknown\"))",
      ".result = coalesce(lookup(\"results\", .complianceState), \"unknown\")",
      ".user = coalesce(.userPrincipalName, \"none\")",
      ".user_id = coalesce(.userId, \"none\")",
      ".device = coalesce(.azureADDeviceId, .deviceId)",
      ".target_type = \"IntuneManagedDevice\""
    ],
    "tables": {
      "results": {
        "noncompliant": "failure",
        "inGracePeriod": "failure",
        "conflict": "failure",
        "error": "failure",
        "unknown": "unknown",
        "configManager": "unknown"
      }
    },
    "match": {
      "selected": "true"
    },
    "fields": {
      "eventId": "id",
      "timeGenerated": "snapshotAt",
      "eventAction": "action",
      "eventResult": "result",
      "actor.username": "user",
      "actor.userId": "user_id",
      "target.type": "target_type",
      "target.id": "device",
      "labels.operatingSystem": "operatingSystem",
      "labels.osVersion": "osVersion",
      "labels.ownerType": "ownerType",
      "labels.isEncrypted": "isEncrypted",
      "labels.jailBroken": "jailBroken",
      "labels.intuneDeviceId": "deviceId",
      "labels.snapshotDate": "snapshotDate"
    }
  }
