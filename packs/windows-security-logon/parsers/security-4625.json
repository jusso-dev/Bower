{
  "version": "1.0",
  "format": "Json",
  "fields": [
    { "sourceName": "id", "type": "Text", "ocsfPath": "metadata.uid", "asimField": "EventOriginalUid", "sensitive": false },
    { "sourceName": "timeCreated", "type": "DateTime", "ocsfPath": "time", "asimField": "TimeGenerated", "sensitive": false },
    { "sourceName": "provider", "type": "Text", "ocsfPath": "metadata.product.name", "asimField": "EventProduct", "sensitive": false },
    { "sourceName": "channel", "type": "Text", "ocsfPath": "metadata.log_name", "asimField": "EventOriginalSubType", "sensitive": false },
    { "sourceName": "eventId", "type": "WholeNumber", "ocsfPath": "metadata.event_code", "asimField": "EventOriginalType", "sensitive": false },
    { "sourceName": "data.LogonType", "type": "WholeNumber", "ocsfPath": "logon_type_id", "asimField": "LogonMethod", "sensitive": false },
    { "sourceName": "data.TargetUserName", "type": "Text", "ocsfPath": "user.name", "asimField": "TargetUsername", "sensitive": true },
    { "sourceName": "data.IpAddress", "type": "Text", "ocsfPath": "src_endpoint.ip", "asimField": "SrcIpAddr", "sensitive": true },
    { "sourceName": "data.Status", "type": "Text", "ocsfPath": "status_code", "asimField": "EventResultDetails", "sensitive": false },
    { "sourceName": "data.SubStatus", "type": "Text", "ocsfPath": "status_detail", "asimField": "EventOriginalResultDetails", "sensitive": false },
    { "sourceName": "user", "type": "Text", "ocsfPath": "actor.user.name", "asimField": "TargetUsername", "sensitive": true },
    { "sourceName": "source_ip", "type": "IpAddress", "ocsfPath": "src_endpoint.ip", "asimField": "SrcIpAddr", "sensitive": true },
    { "sourceName": "result", "type": "Text", "ocsfPath": "status", "asimField": "EventResult", "sensitive": true },
    { "sourceName": "reason", "type": "Text", "ocsfPath": "status_detail", "asimField": "EventResultDetails", "sensitive": false }
  ],
  "runtime": {
    "applicationName": "windows-security",
    "environment": "production",
    "eventCategory": "authentication",
    "eventType": "authentication_failure",
    "eventAction": "authentication.attempt",
    "eventResult": "failure",
    "transforms": [
      ".m = regex_extract(.\"data.IpAddress\", '^(?<ip>[0-9A-Fa-f.:]{2,45})$')",
      "if .channel == \"Security\" && .provider == \"Microsoft-Windows-Security-Auditing\" && .eventId == \"4625\" && .\"data.LogonType\" == \"3\" && .m.ip != null { .result = \"failure\" } else { .result = \"ignored\" }",
      ".user = .\"data.TargetUserName\"",
      ".source_ip = .m.ip",
      ".reason = coalesce(lookup(\"statuses\", lower(.\"data.SubStatus\")), lookup(\"statuses\", lower(.\"data.Status\")), \"OtherFailure\")",
      "del(.m)"
    ],
    "tables": {
      "statuses": {
        "0xc000006a": "InvalidCredentials",
        "0xc000006d": "InvalidCredentials",
        "0xc0000064": "UnknownAccount",
        "0xc0000234": "AccountLockedOut",
        "0xc0000072": "AccountDisabled",
        "0xc0000193": "AccountExpired",
        "0xc0000071": "PasswordExpired",
        "0xc0000224": "PasswordChangeRequired",
        "0xc000006f": "OutsideLogonHours",
        "0xc0000070": "WorkstationRestricted",
        "0xc000015b": "LogonTypeNotGranted",
        "0xc0000133": "ClockSkew",
        "0xc0000413": "AuthenticationFirewall"
      }
    },
    "match": {
      "result": "failure"
    },
    "fields": {
      "eventId": "id",
      "timeGenerated": "timeCreated",
      "actor.username": "user",
      "source.ipAddress": "source_ip",
      "eventOutcomeReason": "reason"
    }
  }
}
