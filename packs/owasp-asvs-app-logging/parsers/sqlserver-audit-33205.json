{
  "version": "1.0",
  "format": "Json",
  "fields": [
    { "sourceName": "id", "type": "Text", "ocsfPath": "metadata.uid", "asimField": "EventOriginalUid", "sensitive": false },
    { "sourceName": "timeCreated", "type": "DateTime", "ocsfPath": "time", "asimField": "TimeGenerated", "sensitive": false },
    { "sourceName": "provider", "type": "Text", "ocsfPath": "metadata.product.name", "asimField": "EventProduct", "sensitive": false },
    { "sourceName": "channel", "type": "Text", "ocsfPath": "metadata.log_name", "asimField": "EventOriginalSubType", "sensitive": false },
    { "sourceName": "eventId", "type": "WholeNumber", "ocsfPath": "metadata.event_code", "asimField": "EventOriginalType", "sensitive": false },
    { "sourceName": "data.action_id", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "data.succeeded", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "data.server_principal_name", "type": "Text", "ocsfPath": "actor.user.name", "asimField": "TargetUsername", "sensitive": true },
    { "sourceName": "data.database_name", "type": "Text", "ocsfPath": "database.name", "asimField": "TargetAppName", "sensitive": false },
    { "sourceName": "data.object_name", "type": "Text", "ocsfPath": "target.name", "asimField": "TargetOriginalAppType", "sensitive": false },
    { "sourceName": "data.client_ip", "type": "Text", "ocsfPath": "src_endpoint.ip", "asimField": "SrcIpAddr", "sensitive": true },
    { "sourceName": "data.statement", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": true },
    { "sourceName": "event_category", "type": "Text", "ocsfPath": "category_name", "asimField": "EventType", "sensitive": true },
    { "sourceName": "event_action", "type": "Text", "ocsfPath": "activity_name", "asimField": "EventSubType", "sensitive": true },
    { "sourceName": "event_result", "type": "Text", "ocsfPath": "status", "asimField": "EventResult", "sensitive": true },
    { "sourceName": "actor_user", "type": "Text", "ocsfPath": "actor.user.name", "asimField": "TargetUsername", "sensitive": true },
    { "sourceName": "source_ip", "type": "IpAddress", "ocsfPath": "src_endpoint.ip", "asimField": "SrcIpAddr", "sensitive": true },
    { "sourceName": "target_type", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "target_name", "type": "Text", "ocsfPath": "database.name", "asimField": "TargetAppName", "sensitive": false },
    { "sourceName": "db_engine", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "statement_class", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "reason", "type": "Text", "ocsfPath": "status_detail", "asimField": "EventResultDetails", "sensitive": true },
    { "sourceName": "matched", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": true }
  ],
  "runtime": {
    "applicationName": "sqlserver-audit",
    "environment": "production",
    "eventCategory": "administrative-activity",
    "eventType": "database_audit",
    "eventAction": "db.ddl",
    "eventResult": "success",
    "transforms": [
      ".code = trim(upper(coalesce(.\"data.action_id\", \"\")))",
      ".ma = lookup(\"actions\", .code)",
      ".actor_user = .\"data.server_principal_name\"",
      ".ipm = regex_extract(.\"data.client_ip\", '^(?<ip>[0-9A-Fa-f.:]{2,45})$')",
      ".source_ip = .ipm.ip",
      ".target_type = \"database\"",
      ".target_name = coalesce(.\"data.object_name\", .\"data.database_name\", \"master\")",
      ".db_engine = \"sqlserver\"",
      ".statement_class = .code",
      ".ok = lower(coalesce(.\"data.succeeded\", \"true\"))",
      ".matched = \"ignored\"",
      "if (.channel == \"Security\" || .channel == \"Application\") && to_string(.eventId) == \"33205\" && starts_with(.provider, \"MSSQL\") && .ma != null && .actor_user != null { .matched = \"yes\"; .event_action = .ma; .event_category = lookup(\"categories\", .code); .event_result = \"success\"; .reason = .code }",
      "if .matched == \"yes\" && .ok != \"true\" { .event_result = \"failure\"; .reason = concat(.code, \"_Failed\") }",
      "del(.code)",
      "del(.ma)",
      "del(.ipm)",
      "del(.ok)"
    ],
    "tables": {
      "actions": {
        "LGIS": "db.logon",
        "LGIF": "db.logon_failure",
        "LGO": "db.logoff",
        "CR": "db.ddl",
        "DR": "db.ddl",
        "AL": "db.ddl",
        "G": "db.dcl",
        "R": "db.dcl",
        "D": "db.dcl",
        "APRL": "db.dcl",
        "ADBO": "db.privileged",
        "SL": "db.sensitive_read",
        "IN": "db.sensitive_write",
        "UP": "db.sensitive_write",
        "DL": "db.sensitive_write",
        "AUSC": "db.audit_config"
      },
      "categories": {
        "LGIS": "authentication",
        "LGIF": "authentication",
        "LGO": "authentication",
        "CR": "administrative-activity",
        "DR": "administrative-activity",
        "AL": "administrative-activity",
        "G": "administrative-activity",
        "R": "administrative-activity",
        "D": "administrative-activity",
        "APRL": "administrative-activity",
        "ADBO": "administrative-activity",
        "SL": "data-access",
        "IN": "data-access",
        "UP": "data-access",
        "DL": "data-access",
        "AUSC": "administrative-activity"
      }
    },
    "match": {
      "matched": "yes"
    },
    "fields": {
      "eventId": "id",
      "timeGenerated": "timeCreated",
      "eventCategory": "event_category",
      "eventAction": "event_action",
      "eventResult": "event_result",
      "actor.username": "actor_user",
      "source.ipAddress": "source_ip",
      "target.type": "target_type",
      "target.name": "target_name",
      "labels.dbEngine": "db_engine",
      "labels.dbStatementClass": "statement_class",
      "eventOutcomeReason": "reason"
    }
  }
}
