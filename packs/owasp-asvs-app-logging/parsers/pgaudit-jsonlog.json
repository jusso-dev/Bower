{
  "version": "1.0",
  "format": "Json",
  "fields": [
    { "sourceName": "timestamp", "type": "Text", "ocsfPath": "time", "asimField": "TimeGenerated", "sensitive": false },
    { "sourceName": "session_id", "type": "Text", "ocsfPath": "metadata.uid", "asimField": "EventOriginalUid", "sensitive": false },
    { "sourceName": "session_line_num", "type": "WholeNumber", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "user", "type": "Text", "ocsfPath": "actor.user.name", "asimField": "TargetUsername", "sensitive": true },
    { "sourceName": "dbname", "type": "Text", "ocsfPath": "database.name", "asimField": "TargetAppName", "sensitive": false },
    { "sourceName": "remote_host", "type": "Text", "ocsfPath": "src_endpoint.ip", "asimField": "SrcIpAddr", "sensitive": true },
    { "sourceName": "error_severity", "type": "Text", "ocsfPath": "severity", "asimField": "EventSeverity", "sensitive": false },
    { "sourceName": "message", "type": "Text", "ocsfPath": "message", "asimField": "EventMessage", "sensitive": true },
    { "sourceName": "event_id", "type": "Text", "ocsfPath": "metadata.uid", "asimField": "EventOriginalUid", "sensitive": false },
    { "sourceName": "event_time", "type": "DateTime", "ocsfPath": "time", "asimField": "TimeGenerated", "sensitive": false },
    { "sourceName": "event_category", "type": "Text", "ocsfPath": "category_name", "asimField": "EventType", "sensitive": true },
    { "sourceName": "event_action", "type": "Text", "ocsfPath": "activity_name", "asimField": "EventSubType", "sensitive": true },
    { "sourceName": "event_result", "type": "Text", "ocsfPath": "status", "asimField": "EventResult", "sensitive": true },
    { "sourceName": "target_type", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "target_name", "type": "Text", "ocsfPath": "database.name", "asimField": "TargetAppName", "sensitive": false },
    { "sourceName": "source_ip", "type": "IpAddress", "ocsfPath": "src_endpoint.ip", "asimField": "SrcIpAddr", "sensitive": true },
    { "sourceName": "db_engine", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "statement_class", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": true },
    { "sourceName": "reason", "type": "Text", "ocsfPath": "status_detail", "asimField": "EventResultDetails", "sensitive": true },
    { "sourceName": "matched", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": true }
  ],
  "runtime": {
    "applicationName": "postgresql-pgaudit",
    "environment": "production",
    "eventCategory": "data-access",
    "eventType": "database_audit",
    "eventAction": "db.ddl",
    "eventResult": "success",
    "transforms": [
      ".event_time = parse_timestamp(.timestamp, \"rfc3339\")",
      ".event_id = concat(\"pgaudit-\", coalesce(.session_id, \"unknown\"), \"-\", coalesce(to_string(.session_line_num), \"0\"))",
      ".m = regex_extract(.message, '^AUDIT: (?:SESSION|OBJECT),[0-9]+,[0-9]+,(?<class>READ|WRITE|FUNCTION|ROLE|DDL|MISC|MISC_SET),(?<command>[A-Z0-9_ ]+),')",
      ".ipm = regex_extract(.remote_host, '^(?<ip>[0-9A-Fa-f.:]{2,45})$')",
      ".source_ip = .ipm.ip",
      ".target_type = \"database\"",
      ".target_name = coalesce(.dbname, \"postgres\")",
      ".db_engine = \"postgresql\"",
      "if .m.class != null && .user != null { .matched = \"yes\"; .statement_class = .m.class; .event_action = coalesce(lookup(\"actions\", .m.class), \"db.privileged\"); .event_category = coalesce(lookup(\"categories\", .m.class), \"administrative-activity\"); .event_result = \"success\"; .reason = .m.command } else if contains(.message, \"password authentication failed\") && .user != null { .matched = \"yes\"; .statement_class = \"AUTH\"; .event_action = \"db.logon_failure\"; .event_category = \"authentication\"; .event_result = \"failure\"; .reason = \"PasswordAuthenticationFailed\" } else { .matched = \"ignored\" }",
      "del(.m)",
      "del(.ipm)"
    ],
    "tables": {
      "actions": {
        "DDL": "db.ddl",
        "ROLE": "db.dcl",
        "READ": "db.sensitive_read",
        "WRITE": "db.sensitive_write",
        "FUNCTION": "db.privileged",
        "MISC": "db.privileged",
        "MISC_SET": "db.audit_config"
      },
      "categories": {
        "DDL": "administrative-activity",
        "ROLE": "administrative-activity",
        "READ": "data-access",
        "WRITE": "data-access",
        "FUNCTION": "administrative-activity",
        "MISC": "administrative-activity",
        "MISC_SET": "administrative-activity"
      }
    },
    "match": {
      "matched": "yes"
    },
    "fields": {
      "eventId": "event_id",
      "timeGenerated": "event_time",
      "eventCategory": "event_category",
      "eventAction": "event_action",
      "eventResult": "event_result",
      "actor.username": "user",
      "source.ipAddress": "source_ip",
      "target.type": "target_type",
      "target.name": "target_name",
      "labels.dbEngine": "db_engine",
      "labels.dbStatementClass": "statement_class",
      "eventOutcomeReason": "reason"
    }
  }
}
