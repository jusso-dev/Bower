{
  "version": "1.0",
  "format": "Json",
  "fields": [
    { "sourceName": "timestamp", "type": "Text", "ocsfPath": "time", "asimField": "TimeGenerated", "sensitive": false },
    { "sourceName": "id", "type": "Text", "ocsfPath": "metadata.uid", "asimField": "EventOriginalUid", "sensitive": false },
    { "sourceName": "class", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "event", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "user", "type": "Text", "ocsfPath": "actor.user.name", "asimField": "TargetUsername", "sensitive": true },
    { "sourceName": "ip", "type": "Text", "ocsfPath": "src_endpoint.ip", "asimField": "SrcIpAddr", "sensitive": true },
    { "sourceName": "db", "type": "Text", "ocsfPath": "database.name", "asimField": "TargetAppName", "sensitive": false },
    { "sourceName": "command", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "status", "type": "WholeNumber", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "event_id", "type": "Text", "ocsfPath": "metadata.uid", "asimField": "EventOriginalUid", "sensitive": false },
    { "sourceName": "event_time", "type": "DateTime", "ocsfPath": "time", "asimField": "TimeGenerated", "sensitive": false },
    { "sourceName": "event_category", "type": "Text", "ocsfPath": "category_name", "asimField": "EventType", "sensitive": true },
    { "sourceName": "event_action", "type": "Text", "ocsfPath": "activity_name", "asimField": "EventSubType", "sensitive": true },
    { "sourceName": "event_result", "type": "Text", "ocsfPath": "status", "asimField": "EventResult", "sensitive": true },
    { "sourceName": "actor_user", "type": "Text", "ocsfPath": "actor.user.name", "asimField": "TargetUsername", "sensitive": true },
    { "sourceName": "source_ip", "type": "IpAddress", "ocsfPath": "src_endpoint.ip", "asimField": "SrcIpAddr", "sensitive": true },
    { "sourceName": "target_type", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "target_name", "type": "Text", "ocsfPath": "database.name", "asimField": "TargetAppName", "sensitive": true },
    { "sourceName": "db_engine", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": false },
    { "sourceName": "statement_class", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": true },
    { "sourceName": "reason", "type": "Text", "ocsfPath": "status_detail", "asimField": "EventResultDetails", "sensitive": true },
    { "sourceName": "matched", "type": "Text", "ocsfPath": null, "asimField": null, "sensitive": true }
  ],
  "runtime": {
    "applicationName": "mysql-audit",
    "environment": "production",
    "eventCategory": "data-access",
    "eventType": "database_audit",
    "eventAction": "db.ddl",
    "eventResult": "success",
    "transforms": [
      ".event_time = parse_timestamp(.timestamp, \"rfc3339\")",
      ".event_id = concat(\"mysql-audit-\", to_string(.id))",
      ".actor_user = coalesce(.account.user, .user)",
      ".ipm = regex_extract(coalesce(.ip, .connection_data.ip), '^(?<ip>[0-9A-Fa-f.:]{2,45})$')",
      ".source_ip = .ipm.ip",
      ".target_type = \"database\"",
      ".target_name = coalesce(.db, .table_access_data.db, .connection_data.db, \"mysql\")",
      ".db_engine = \"mysql\"",
      ".cmd = upper(coalesce(.command, .general_data.sql_command, .event, \"\"))",
      ".st = coalesce(.status, .connection_data.status, .general_data.status, 0)",
      ".matched = \"ignored\"",
      "if .class == \"connection\" && .event == \"connect\" && .actor_user != null { .matched = \"yes\"; .event_category = \"authentication\"; .statement_class = \"CONNECT\" }",
      "if .matched == \"yes\" && .class == \"connection\" && .event == \"connect\" && .st == 0 { .event_action = \"db.logon\"; .event_result = \"success\"; .reason = \"ConnectSucceeded\" }",
      "if .matched == \"yes\" && .class == \"connection\" && .event == \"connect\" && .st != 0 { .event_action = \"db.logon_failure\"; .event_result = \"failure\"; .reason = concat(\"MySqlStatus_\", to_string(.st)) }",
      "if .class == \"connection\" && .event == \"disconnect\" && .actor_user != null { .matched = \"yes\"; .event_category = \"authentication\"; .event_action = \"db.logoff\"; .event_result = \"success\"; .statement_class = \"DISCONNECT\"; .reason = \"Disconnect\" }",
      "if .matched == \"ignored\" && lookup(\"actions\", .cmd) != null && .actor_user != null { .matched = \"yes\"; .event_action = lookup(\"actions\", .cmd); .event_category = lookup(\"categories\", .cmd); .statement_class = .cmd; .event_result = \"success\"; .reason = .cmd }",
      "if .matched == \"yes\" && .class != \"connection\" && .st != 0 { .event_action = \"db.query_error\"; .event_category = \"data-access\"; .event_result = \"failure\"; .reason = concat(\"MySqlStatus_\", to_string(.st)) }",
      "del(.ipm)",
      "del(.cmd)",
      "del(.st)"
    ],
    "tables": {
      "actions": {
        "CREATE_TABLE": "db.ddl",
        "ALTER_TABLE": "db.ddl",
        "DROP_TABLE": "db.ddl",
        "CREATE_DB": "db.ddl",
        "DROP_DB": "db.ddl",
        "GRANT": "db.dcl",
        "REVOKE": "db.dcl",
        "CREATE_USER": "db.dcl",
        "DROP_USER": "db.dcl",
        "ALTER_USER": "db.dcl",
        "SELECT": "db.sensitive_read",
        "READ": "db.sensitive_read",
        "INSERT": "db.sensitive_write",
        "UPDATE": "db.sensitive_write",
        "DELETE": "db.sensitive_write"
      },
      "categories": {
        "CREATE_TABLE": "administrative-activity",
        "ALTER_TABLE": "administrative-activity",
        "DROP_TABLE": "administrative-activity",
        "CREATE_DB": "administrative-activity",
        "DROP_DB": "administrative-activity",
        "GRANT": "administrative-activity",
        "REVOKE": "administrative-activity",
        "CREATE_USER": "administrative-activity",
        "DROP_USER": "administrative-activity",
        "ALTER_USER": "administrative-activity",
        "SELECT": "data-access",
        "READ": "data-access",
        "INSERT": "data-access",
        "UPDATE": "data-access",
        "DELETE": "data-access"
      }
    },
    "match": {
      "matched": "yes"
    },
    "fields": {
      "eventId": "event_id",
      "timeGenerated": "event_time",
      "eventCategory": "event_category",
      "eventAction": "event_action",
      "eventResult": "event_result",
      "actor.username": "actor_user",
      "source.ipAddress": "source_ip",
      "target.type": "target_type",
      "target.name": "target_name",
      "labels.dbEngine": "db_engine",
      "labels.dbStatementClass": "statement_class",
      "eventOutcomeReason": "reason"
    }
  }
}
