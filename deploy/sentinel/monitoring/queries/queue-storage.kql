// Bower: queue storage pressure. Fires when a collector's newest health record shows the queue
// database's in-use pages at or above __PAGES_PERCENT__% of its page limit, undelivered data at or above
// __STORAGE_PERCENT__% of BOWER_QUEUE_MAX_BYTES, delivery backpressure, or any record in the window
// reports intake refused for queue capacity (HTTP 503; syslog and Windows sources stop reading).
// The page limit is reached first (about cap + 4 MiB of rows, indexes, ledger and retained
// acknowledged rows). In-use pages can fall after delivery and retention free them; the
// file may retain free pages. A full queue cannot queue health records: collector-health-missing
// covers a queue that is already full.
// EXTENSION POINT (storage): when collectors report free disk/watermarks under Attributes.storage,
// add them to StorageSignal below, reporting unavailable values as incomplete coverage.
let usedPercent = __STORAGE_PERCENT__;
let pagesPercent = __PAGES_PERCENT__;
BowerSecurity_CL
| where EventType == "collector_health"
| extend Refusals = coalesce(toint(Attributes.intake.capacityRefusals), 0) + coalesce(toint(Attributes.intake.privacyAlertRefusals), 0)
| summarize arg_max(TimeGenerated, Attributes), RefusalsInWindow = sum(Refusals) by CollectorId
| extend CapacityUsedPercent = todouble(Attributes.storage.capacityUsedPercent),
    QueuePagesUsedPercent = todouble(Attributes.storage.queuePagesUsedPercent),
    UndeliveredMiB = todouble(Attributes.storage.undeliveredMiB),
    QueuePagesUsedMiB = todouble(Attributes.storage.queuePagesUsedMiB),
    DeliveryStatus = tostring(Attributes.delivery.status)
| extend StorageMetricsIncomplete = isnull(QueuePagesUsedPercent) or isnull(CapacityUsedPercent)
    or not(isfinite(QueuePagesUsedPercent)) or not(isfinite(CapacityUsedPercent))
    or QueuePagesUsedPercent < 0.0 or CapacityUsedPercent < 0.0
| extend StorageSignal = StorageMetricsIncomplete or QueuePagesUsedPercent >= pagesPercent
    or CapacityUsedPercent >= usedPercent
    or DeliveryStatus == "backpressure" or RefusalsInWindow > 0
| where StorageSignal
| project CollectorId, RecordAt = TimeGenerated, QueuePagesUsedPercent, QueuePagesUsedMiB, CapacityUsedPercent, UndeliveredMiB, RefusalsInWindow, DeliveryStatus, StorageMetricsIncomplete
