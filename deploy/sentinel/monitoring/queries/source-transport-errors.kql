// Bower: source loss indicators before acceptance. Syslog connection refusals, TLS handshake,
// reload and revocation failures (and sessions closed by revocation), framing/parse errors,
// timeouts or drops, connection churn above __SYSLOG_CHURN__ new connections per
// health interval, and Windows Event Log read, parse, malformed or oversized errors, gaps, resets
// or a failed subscription state.
// Health record counters are deltas since the previous record of the same process.
// Two distinct records with retry activity or Windows backpressure trigger a sustained warning.
let churn = __SYSLOG_CHURN__;
let health = BowerSecurity_CL
    | where EventType == "collector_health"
    | project TimeGenerated, CollectorId, Attributes;
let syslog = health
    | mv-expand Listener = Attributes.syslog
    | where isnotempty(Listener)
    | extend Errors = coalesce(toint(Listener.connectionsRejected), 0) + coalesce(toint(Listener.sendersDenied), 0)
        + coalesce(toint(Listener.tlsHandshakeFailures), 0) + coalesce(toint(Listener.malformed), 0)
        + coalesce(toint(Listener.oversized), 0) + coalesce(toint(Listener.framingErrors), 0)
        + coalesce(toint(Listener.timeouts), 0) + coalesce(toint(Listener.dropped), 0)
        + coalesce(toint(Listener.submitFailures), 0) + coalesce(toint(Listener.receiveErrors), 0)
        + coalesce(toint(Listener.parserErrors), 0) + coalesce(toint(Listener.tlsReloadFailures), 0)
        + coalesce(toint(Listener.tlsRevoked), 0) + coalesce(toint(Listener.tlsSessionsClosed), 0),
        NewConnections = coalesce(toint(Listener.connectionsAccepted), 0),
        Retrying = coalesce(toint(Listener.retries), 0) > 0 or coalesce(toint(Listener.relpBusyCloses), 0) > 0
    | summarize Errors = sum(Errors), MaxNewConnections = tolong(max(NewConnections)), FailedStates = tolong(0), Records = count(),
        ImpairedRecords = tolong(array_length(make_set_if(TimeGenerated, Retrying, 2)))
        by CollectorId, Source = strcat("syslog:", tostring(Listener.id));
let windows = health
    | mv-expand Subscription = Attributes.windowsEventLog
    | where isnotempty(Subscription)
    | extend Errors = coalesce(toint(Subscription.readErrors), 0) + coalesce(toint(Subscription.gaps), 0)
        + coalesce(toint(Subscription.resets), 0) + coalesce(toint(Subscription.submitFailures), 0)
        + coalesce(toint(Subscription.parserErrors), 0) + coalesce(toint(Subscription.malformed), 0)
        + coalesce(toint(Subscription.oversized), 0) + coalesce(toint(Subscription.cursorConflicts), 0),
        State = tostring(Subscription.state), RetryCount = coalesce(toint(Subscription.retries), 0)
    | summarize Errors = sum(Errors), MaxNewConnections = 0, FailedStates = countif(State !in ("starting", "running", "backpressure")), Records = count(),
        ImpairedRecords = tolong(array_length(make_set_if(TimeGenerated, State == "backpressure" or RetryCount > 0, 2)))
        by CollectorId, Source = strcat("winevt:", tostring(Subscription.id));
// Missing coverage metadata (including older collectors) is unknown, not complete.
let syslogCoverage = health
    | where coalesce(tobool(Attributes.monitoringCoverage.syslogComplete), false) == false
    | summarize Records = count() by CollectorId
    | extend Source = "syslog:coverage-incomplete", Errors = tolong(0), MaxNewConnections = tolong(0), FailedStates = tolong(0), ImpairedRecords = tolong(0), CoverageIncomplete = true;
let windowsCoverage = health
    | where coalesce(tobool(Attributes.monitoringCoverage.windowsEventLogComplete), false) == false
    | summarize Records = count() by CollectorId
    | extend Source = "winevt:coverage-incomplete", Errors = tolong(0), MaxNewConnections = tolong(0), FailedStates = tolong(0), ImpairedRecords = tolong(0), CoverageIncomplete = true;
union syslog, windows, syslogCoverage, windowsCoverage
| extend CoverageIncomplete = coalesce(CoverageIncomplete, false)
| where Errors > 0 or MaxNewConnections > churn or FailedStates > 0 or ImpairedRecords >= 2 or CoverageIncomplete
| project CollectorId, Source, Errors, MaxNewConnections, FailedStates, Records, ImpairedRecords, CoverageIncomplete
