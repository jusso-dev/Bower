// Bower ASVS pack: password spraying or credential stuffing from one address.
// Application authentication_failure events (BWR-POL-AUTH-FAILURE) from one source address
// against at least `accountThreshold` distinct accounts in one event-time bucket. Usernames
// are HMAC pseudonyms (owasp-asvs-app-logging privacy profile), so accounts stay countable
// without being readable. Successful sign-ins from the same address in the bucket are
// reported as `SuccessesAfterFailures`: stuffing that worked. ASVS 5.0 V16.3.1, V6.3.1.
// Replay-safe: counts the collapsed rows of BowerSecurityEventsOfType and alerts once per
// (address, bucket) through the detection key. Late rows are re-evaluated for `catchUp`.
// asvs.bicep replaces the values below; keep them on one line each.
let accountThreshold = 10;
let bucketSize = 10m;
let settleDelay = 5m;
let frequency = 5m;
let catchUp = 60m;
let maxDelay = 360m;
let ruleKey = "bower-asvs-password-spray:default";
let windowEnd = bin(now() - settleDelay, frequency);
let catchUpStart = windowEnd - catchUp;
let horizon = bin(catchUpStart - maxDelay, bucketSize);
let alerted = SecurityAlert
    | where ProviderName == "ASI Scheduled Alerts"
    | extend BowerDetectionKey = tostring(todynamic(tostring(todynamic(ExtendedProperties)["Custom Details"])).BowerDetectionKey[0])
    | where BowerDetectionKey startswith strcat(ruleKey, "|")
    | distinct BowerDetectionKey;
let candidates = materialize(BowerSecurityEventsOfType(dynamic(["authentication_failure", "authentication_success"]))
    // Host sign-ins have their own rules (wec-brute-force, ssh packs).
    | where ApplicationName !in ("windows-security", "ssh-gateway", "linux-sshd")
    | where isnotempty(SourceIpAddress) and isnotempty(coalesce(ActorUsername, ActorUserId))
    | where BowerEventTime >= horizon and BowerFirstIngested < windowEnd
    | where BowerFirstIngested - BowerEventTime <= maxDelay
    | extend Account = coalesce(ActorUsername, ActorUserId), BucketStart = bin(BowerEventTime, bucketSize));
candidates
// count_distinctif is exact; dcount() is an estimate and must not gate an alert.
| summarize Failures = countif(EventType == "authentication_failure"),
    DistinctAccounts = count_distinctif(Account, EventType == "authentication_failure"),
    SuccessesAfterFailures = countif(EventType == "authentication_success"),
    FailedAccounts = make_set_if(Account, EventType == "authentication_failure", 20),
    Applications = make_set(ApplicationName, 10), Collectors = make_set(CollectorId, 10),
    LastIngested = max(BowerFirstIngested), FirstEvent = min(BowerEventTime), LastEvent = max(BowerEventTime)
    by SourceIpAddress, BucketStart
| where DistinctAccounts >= accountThreshold
| where LastIngested >= catchUpStart
| extend BowerDetectionKey = strcat(ruleKey, "|", SourceIpAddress, "|", tostring(BucketStart))
| where BowerDetectionKey !in (alerted)
| project BowerDetectionKey, SourceIpAddress, BucketStart, Failures, DistinctAccounts, SuccessesAfterFailures,
    FailedAccounts, Applications, Collectors, FirstEvent, LastEvent, EvaluatedAt = now()
