// Bower ASVS pack: mass export or bulk sensitive reads by one user.
// sensitive_data_exported (BWR-POL-SENSITIVE-EXPORT) and sensitive_data_accessed
// (BWR-PACK-ASVS-SENSITIVE-DATA) records summed per user and application in one event-time
// bucket. Alerts when the record total reaches `recordThreshold` or the export count reaches
// `exportThreshold`. ASVS 5.0 V16.3.2, V2.4.1. Replay-safe: once per (user, app, bucket).
let recordThreshold = 10000;
let exportThreshold = 5;
let bucketSize = 60m;
let settleDelay = 5m;
let frequency = 5m;
let catchUp = 60m;
let maxDelay = 360m;
let ruleKey = "bower-asvs-mass-export:default";
let windowEnd = bin(now() - settleDelay, frequency);
let catchUpStart = windowEnd - catchUp;
let horizon = bin(catchUpStart - maxDelay, bucketSize);
let alerted = SecurityAlert
    | where ProviderName == "ASI Scheduled Alerts"
    | extend BowerDetectionKey = tostring(todynamic(tostring(todynamic(ExtendedProperties)["Custom Details"])).BowerDetectionKey[0])
    | where BowerDetectionKey startswith strcat(ruleKey, "|")
    | distinct BowerDetectionKey;
// The typed parser drops Attributes; join the record count back from the raw table by identity.
let counts = BowerSecurity_CL
    | where EventType in ("sensitive_data_exported", "sensitive_data_accessed")
    | summarize RecordCount = take_any(tolong(Attributes.recordCount)) by CollectorId, EventId;
BowerSecurityEventsOfType(dynamic(["sensitive_data_exported", "sensitive_data_accessed"]))
| where EventResult == "success" and isnotempty(ActorUserId)
| where BowerEventTime >= horizon and BowerFirstIngested < windowEnd
| where BowerFirstIngested - BowerEventTime <= maxDelay
| join kind=leftouter counts on CollectorId, EventId
| extend BucketStart = bin(BowerEventTime, bucketSize)
| summarize Records = sum(coalesce(RecordCount, 1)), Exports = countif(EventType == "sensitive_data_exported"),
    Events = count(), LastIngested = max(BowerFirstIngested), FirstEvent = min(BowerEventTime), LastEvent = max(BowerEventTime),
    Collectors = make_set(CollectorId, 10)
    by ActorUserId, ApplicationName, BucketStart
| where Records >= recordThreshold or Exports >= exportThreshold
| where LastIngested >= catchUpStart
| extend BowerDetectionKey = strcat(ruleKey, "|", ApplicationName, "|", ActorUserId, "|", tostring(BucketStart))
| where BowerDetectionKey !in (alerted)
| project BowerDetectionKey, ActorUserId, ApplicationName, BucketStart, Records, Exports, Events, Collectors,
    FirstEvent, LastEvent, EvaluatedAt = now()
