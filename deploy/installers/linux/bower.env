# Bower collector settings, read by bower.service (EnvironmentFile=/etc/bower/bower.env).
# Installed as /etc/bower/bower.env (root:bower 0640) when it does not exist yet.
# Never put a secret value in this file: point at a file under /etc/bower/secrets
# (root:bower 0640) instead. Uninstall deletes this file and /etc/bower/secrets.
# Every variable is documented in the README "Configuration" table.

# Identity reported to management. Defaults to the host name.
#BOWER_COLLECTOR_ID=edge-01
#BOWER_ENVIRONMENT=production

# Management with a one-time enrolment token (the offline installer and the Ansible
# role write these). The token file is deleted once management consumed or refused it.
#BOWER_MANAGEMENT_ENDPOINT=https://bower-management.example.com/
#BOWER_MANAGEMENT_AUTH=enrolment
#BOWER_MANAGEMENT_ENROLMENT_TOKEN_FILE=/var/lib/bower/enrolment/enrolment-token
#BOWER_MANAGEMENT_ENROLMENT_TOKEN_REMOVE_AFTER_USE=true
#BOWER_MANAGEMENT_COMMAND_TRUSTED_KEYS=/etc/bower/keys/command-trusted.pem

# Signed packs and the public keys trusted to sign them.
#BOWER_PACKS=/etc/bower/packs/linux-ssh-gateway.bowerpack
#BOWER_PACK_TRUSTED_KEYS=/etc/bower/keys/pack-trusted.pem

# Producers on other hosts need a token; keep it in a file.
#BOWER_LISTEN_URL=https://0.0.0.0:4319
#BOWER_INGEST_TOKEN_FILE=/etc/bower/secrets/ingest-token

# Delivery to Microsoft Sentinel (Logs Ingestion API).
#BOWER_OUTPUT=azure-logs-ingestion
#BOWER_DCE_ENDPOINT=https://example.australiaeast-1.ingest.monitor.azure.com
#BOWER_DCR_ID=dcr-00000000000000000000000000000000
