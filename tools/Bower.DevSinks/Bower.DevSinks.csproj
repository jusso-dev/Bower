<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Local stand-in destinations for the Aspire harness only (src/Bower.AppHost). Never
       published, packaged or deployed. Synthetic data only; holds records in memory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Bower.ServiceDefaults/Bower.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bower.UnitTests" />
  </ItemGroup>
</Project>
