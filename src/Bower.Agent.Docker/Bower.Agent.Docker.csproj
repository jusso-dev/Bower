<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Native AOT: one self-contained native executable per RID. -->
    <PublishAot>true</PublishAot>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <!-- The chiseled runtime image ships without ICU. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared framework: generic host, logging and IHttpClientFactory without new packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bower.Forwarding/Bower.Forwarding.csproj" />
    <ProjectReference Include="../Bower.Persistence/Bower.Persistence.csproj" />
    <ProjectReference Include="../Bower.Source.Docker/Bower.Source.Docker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bower.UnitTests" />
  </ItemGroup>
</Project>
