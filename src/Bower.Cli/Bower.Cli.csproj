<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bower</AssemblyName>
    <!-- Native AOT: one self-contained native executable per RID (plus the native SQLite
         library). Self-contained only for RID-specific publishes. -->
    <PublishAot>true</PublishAot>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bower.Contracts/Bower.Contracts.csproj" />
    <ProjectReference Include="../Bower.Core/Bower.Core.csproj" />
    <ProjectReference Include="../Bower.Persistence/Bower.Persistence.csproj" />
    <ProjectReference Include="../Bower.PolicyEngine/Bower.PolicyEngine.csproj" />
    <ProjectReference Include="..\Bower.Pipeline\Bower.Pipeline.csproj" />
    <ProjectReference Include="../Bower.Dcr/Bower.Dcr.csproj" />
    <ProjectReference Include="../Bower.Evidence/Bower.Evidence.csproj" />
    <ProjectReference Include="../Bower.Packs/Bower.Packs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bower.UnitTests" />
  </ItemGroup>
</Project>
