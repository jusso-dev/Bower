<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Strongly typed Bower security telemetry SDK.</Description>
    <!-- Consumer-facing library: also built for .NET 10 LTS so applications not yet on .NET 11
         can reference it. The rest of Bower targets .NET 11 only. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <PackageId>Bower.Sdk</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bower.Contracts/Bower.Contracts.csproj" />
  </ItemGroup>
  <!-- In the .NET 11 shared framework; a separate package only for the .NET 10 build (NU1510 on net11.0). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
