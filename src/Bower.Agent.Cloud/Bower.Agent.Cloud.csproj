<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Not published as Native AOT (yet): Google.Apis.Auth reads credential files and token
         responses through Google.Apis.Core's NewtonsoftJsonSerializer, which uses
         reflection-based Newtonsoft.Json (IL2026/IL3050/IL2070 in Google.Apis.Core and
         Newtonsoft.Json; see docs/architecture/dependencies.md). Bower's own code here is
         still trim and AOT analysed at build time (IsAotCompatible), and the AWS SDK path is
         AOT clean. Published self-contained on the .NET runtime instead. -->
    <PublishAot>false</PublishAot>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <!-- The chiseled runtime image ships without ICU. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared framework: generic host, logging and IHttpClientFactory without new packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- See docs/architecture/dependencies.md: SQS/S3 clients with the default credential
         chain (instance profile, ECS task role, IRSA via STS web identity) and Google
         Application Default Credentials including Workload Identity Federation. -->
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.SecurityToken" />
    <PackageReference Include="AWSSDK.SQS" />
    <PackageReference Include="Google.Apis.Auth" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bower.Forwarding/Bower.Forwarding.csproj" />
    <ProjectReference Include="../Bower.Source.Aws/Bower.Source.Aws.csproj" />
    <ProjectReference Include="../Bower.Source.Gcp/Bower.Source.Gcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bower.UnitTests" />
  </ItemGroup>
</Project>
