<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Native AOT: one self-contained native executable per RID. Google Application Default
         Credentials are implemented in-house (Gcp/Auth) with source-generated JSON, so no
         reflection-based Google client library is needed (docs/architecture/dependencies.md). -->
    <PublishAot>true</PublishAot>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <!-- The chiseled runtime image ships without ICU. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared framework: generic host, logging and IHttpClientFactory without new packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- See docs/architecture/dependencies.md: SQS/S3 clients with the default credential
         chain (instance profile, ECS task role, IRSA via STS web identity). -->
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.SecurityToken" />
    <PackageReference Include="AWSSDK.SQS" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bower.Forwarding/Bower.Forwarding.csproj" />
    <ProjectReference Include="../Bower.Source.Aws/Bower.Source.Aws.csproj" />
    <ProjectReference Include="../Bower.Source.Gcp/Bower.Source.Gcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bower.UnitTests" />
  </ItemGroup>
</Project>
