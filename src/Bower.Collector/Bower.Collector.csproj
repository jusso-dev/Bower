<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Native AOT: one self-contained native executable per RID (plus the native SQLite
         library). Self-contained only for RID-specific publishes, so tests can reference
         the host. -->
    <PublishAot>true</PublishAot>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <!-- The chiseled runtime image ships without ICU; all comparisons are ordinal. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bower.Core/Bower.Core.csproj" />
    <ProjectReference Include="../Bower.Forwarding/Bower.Forwarding.csproj" />
    <ProjectReference Include="../Bower.Jobs/Bower.Jobs.csproj" />
    <ProjectReference Include="../Bower.Output.AmaSpool/Bower.Output.AmaSpool.csproj" />
    <ProjectReference Include="../Bower.Output.AzureLogsIngestion/Bower.Output.AzureLogsIngestion.csproj" />
    <ProjectReference Include="../Bower.Packs/Bower.Packs.csproj" />
    <ProjectReference Include="../Bower.Source.Syslog/Bower.Source.Syslog.csproj" />
    <ProjectReference Include="../Bower.Source.WindowsEventLog/Bower.Source.WindowsEventLog.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
</Project>
