# /etc/bower/bower.env additions for Azure Monitor Agent on Linux.
# Bower selects and redacts events, then writes them to local syslog (/dev/log);
# AMA's syslog collection uploads them. See docs/getting-started/azure-monitor-agent.md.
BOWER_OUTPUT=syslog
# 20 is local4. Match the "facility" parameter of deploy/bicep/ama-syslog-dcr.bicep.
BOWER_SYSLOG_OUTPUT_FACILITY=20
# rsyslog's default MaxMessageSize. Raise both together.
BOWER_SYSLOG_OUTPUT_MAX_BYTES=8192
