# /etc/bower/bower.env additions for Azure Monitor Agent on Linux.
# Bower selects and redacts events, then writes them to local syslog (/dev/log);
# AMA's syslog collection uploads them. The packaged /etc/bower/bower.env has the same
# block, commented. Create and associate the collection rule before switching the output:
# see docs/getting-started/azure-monitor-agent.md and docs/deployment/ama-syslog-output.md.
BOWER_OUTPUT=ama-syslog
# local0 to local7. Match the "facility" parameter of deploy/bicep/ama-syslog-dcr.bicep.
#BOWER_AMA_SYSLOG_FACILITY=local4
# The whole datagram. Keep it at least 512 below rsyslog's MaxMessageSize (8 KiB by default).
# At 7680 the largest event is 5,730 bytes of JSON.
#BOWER_AMA_SYSLOG_MAX_BYTES=7680
