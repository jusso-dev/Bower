# /etc/bower/bower.env additions for Azure Monitor Agent companion mode.
# Bower redacts and selects events, then writes them to the spool; AMA uploads them.
BOWER_OUTPUT=ama-spool
BOWER_AMA_SPOOL_PATH=/var/spool/bower
# Applications on this box post to the local collector; loopback needs no token.
BOWER_LISTEN_URL=http://127.0.0.1:4319
