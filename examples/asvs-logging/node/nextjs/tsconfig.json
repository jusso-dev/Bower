{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "es2023"], "allowJs": true, "skipLibCheck": true, "strict": true, "noEmit": true,
    "module": "esnext", "moduleResolution": "bundler", "resolveJsonModule": true, "isolatedModules": true, "jsx": "preserve",
    "incremental": true, "esModuleInterop": true, "paths": { "@/*": ["./*"] }, "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
