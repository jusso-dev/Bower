<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <!-- Test-only: in-process HTTP server for collector and management API integration tests. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../../src/Bower.Agent.Cloud/Bower.Agent.Cloud.csproj" />
    <ProjectReference Include="../../src/Bower.Agent.Docker/Bower.Agent.Docker.csproj" />
    <ProjectReference Include="../../src/Bower.Cli/Bower.Cli.csproj" />
    <ProjectReference Include="../../src/Bower.Collector/Bower.Collector.csproj" />
    <ProjectReference Include="../../src/Bower.Source.Docker/Bower.Source.Docker.csproj" />
    <ProjectReference Include="../../src/Bower.Source.Syslog/Bower.Source.Syslog.csproj" />
    <ProjectReference Include="../../src/Bower.Core/Bower.Core.csproj" />
    <ProjectReference Include="../../src/Bower.Evidence/Bower.Evidence.csproj" />
    <ProjectReference Include="../../src/Bower.Integrity/Bower.Integrity.csproj" />
    <ProjectReference Include="../../src/Bower.Packs/Bower.Packs.csproj" />
    <ProjectReference Include="../../src/Bower.Output.AmaSpool/Bower.Output.AmaSpool.csproj" />
    <ProjectReference Include="../../src/Bower.Management.Api/Bower.Management.Api.csproj" />
    <ProjectReference Include="../../src/Bower.Persistence/Bower.Persistence.csproj" />
    <ProjectReference Include="../../src/Bower.Sdk/Bower.Sdk.csproj" />
    <ProjectReference Include="../../src/Bower.Source.SqlServer/Bower.Source.SqlServer.csproj" />
    <ProjectReference Include="../../src/Bower.Source.Aws/Bower.Source.Aws.csproj" />
    <ProjectReference Include="../../src/Bower.Ocsf/Bower.Ocsf.csproj" />
    <ProjectReference Include="../../src/Bower.Detection/Bower.Detection.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../schemas/**/*.json">
      <Link>schemas/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../policies/**/*.yaml">
      <Link>policies/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- C# outcomes pinned for the Rust port (rust/crates/bower-policy). -->
    <Content Include="../../rust/crates/bower-policy/tests/fixtures/**/*">
      <Link>policy-vectors/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../packs/**/*">
      <Link>packs/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../deploy/privacy/*.yaml">
      <Link>deploy/privacy/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../deploy/bicep/main.bicep">
      <Link>deploy/main.bicep</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- C# suppression outcomes pinned for the Rust port (rust/crates/bower-core). -->
    <Content Include="../../rust/crates/bower-core/tests/fixtures/suppression-vectors.json">
      <Link>core-vectors/suppression-vectors.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../rust/crates/bower-persistence/tests/fixtures/**/*">
      <Link>persistence-vectors/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../rust/crates/bower-detection/tests/fixtures/**/*">
      <Link>detection-vectors/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- C#-signed pack fixtures and bundle-diff outputs shared with the Rust port (rust/crates/bower-cli). -->
    <Content Include="../../rust/crates/bower-packs/tests/fixtures/*.bowerpack;../../rust/crates/bower-packs/tests/fixtures/*.pem">
      <Link>pack-fixtures/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../rust/crates/bower-cli/tests/fixtures/bundle-diff/*">
      <Link>bundle-diff/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- bower top render fixtures shared with the Rust port (rust/crates/bower-cli). -->
    <Content Include="../../rust/crates/bower-cli/tests/fixtures/top/*">
      <Link>top-fixtures/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Pipeline node kind vectors shared with the Rust port (rust/crates/bower-pipeline). -->
    <Content Include="../../rust/crates/bower-pipeline/tests/fixtures/node-kinds.txt">
      <Link>pipeline-vectors/node-kinds.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../rust/crates/bower-packs/tests/fixtures/csharp-vectors/transform-journald-ssh.json">
      <Link>pack-vectors/transform-journald-ssh.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Transform language conformance vectors shared with the Rust port (rust/crates/bower-pipeline). -->
    <Content Include="../../rust/crates/bower-pipeline/tests/fixtures/transform-vectors.json">
      <Link>pipeline-vectors/transform-vectors.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Syslog parser vectors and TEST-ONLY TLS keys shared with the Rust port (rust/crates/bower-source-syslog). -->
    <Content Include="../../rust/crates/bower-source-syslog/tests/fixtures/**/*">
      <Link>syslog-vectors/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../rules/**/*.yml">
      <Link>rules/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/queue-migration-check/Bower.QueueMigrationCheck.csproj" />
    <ProjectReference Include="..\..\src\Bower.Pipeline\Bower.Pipeline.csproj" />
    <ProjectReference Include="..\..\src\Bower.Analytics\Bower.Analytics.csproj" />
    <ProjectReference Include="..\..\src\Bower.Source.Ama\Bower.Source.Ama.csproj" />
    <ProjectReference Include="..\..\src\Bower.Dcr\Bower.Dcr.csproj" />
    <ProjectReference Include="..\..\src\Bower.Agent.Aws\Bower.Agent.Aws.csproj" />
  </ItemGroup>
</Project>
