<Project Sdk="Microsoft.NET.Sdk">
  <!-- Boots src/Bower.AppHost and sends one canary through each local output. Opt-in: the
       tests skip unless BOWER_ASPIRE_TESTS=1, because they need Docker (or another container
       runtime), the Aspire CLI bundle and, for the functions resource, Azure Functions Core
       Tools. See docs/getting-started/aspire.md. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../../src/Bower.AppHost/Bower.AppHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
