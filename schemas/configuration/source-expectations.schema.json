{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bower.security/schemas/configuration/source-expectations-v1.json",
  "title": "Bower Source Expectations",
  "description": "Applications that must keep sending accepted security events (BOWER_SOURCE_EXPECTATIONS), with the longest acceptable silence for each.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "sources"],
  "properties": {
    "apiVersion": {"const": "bower.security/v1"},
    "kind": {"const": "SourceExpectations"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["application", "environment", "maximumSilenceMinutes"],
        "properties": {
          "application": {"type": "string", "pattern": "\\S"},
          "environment": {"type": "string", "pattern": "\\S"},
          "maximumSilenceMinutes": {"type": "integer", "minimum": 1, "maximum": 10080}
        }
      }
    }
  }
}
