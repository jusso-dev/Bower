{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bower.security/schemas/configuration/windows-event-log-source-v1.json",
  "title": "Bower Windows Event Log Source",
  "description": "Channel subscriptions with explicit event ID allow-lists, each mapped by one signed pack parser (BOWER_WINDOWS_EVENTLOG_CONFIG, C# collector on Windows only). The collector generates the Windows query; there is no free-text query or collect-all form.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "subscriptions"],
  "properties": {
    "apiVersion": {"const": "bower.security/v1"},
    "kind": {"const": "WindowsEventLogSource"},
    "subscriptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "channel", "eventIds", "pack", "parser"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "channel": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9_./-](?:[A-Za-z0-9 _./-]*[A-Za-z0-9_./-])?$"},
          "eventIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0, "maximum": 65535}
          },
          "providers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9_.$-](?:[A-Za-z0-9 _.$-]*[A-Za-z0-9_.$-])?$"}
          },
          "pack": {"type": "string", "pattern": "\\S"},
          "parser": {"type": "integer", "minimum": 0},
          "readExisting": {"type": "boolean", "default": false},
          "includeMessage": {"type": "boolean", "default": false},
          "pollIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 300, "default": 2},
          "batchSize": {"type": "integer", "minimum": 1, "maximum": 256, "default": 64}
        }
      }
    }
  }
}
