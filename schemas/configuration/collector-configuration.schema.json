{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bower.security/schemas/configuration/collector-v1.json",
  "title": "Bower Collector Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "collector", "storage", "policies", "outputs"],
  "properties": {
    "apiVersion": {"const": "bower.security/v1"},
    "kind": {"const": "CollectorConfiguration"},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "environment", "mode"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "environment": {"type": "string", "minLength": 1, "maxLength": 64},
        "mode": {"enum": ["production", "discovery", "audit", "test"]}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "path", "maximumSize"],
      "properties": {
        "provider": {"const": "sqlite"},
        "path": {"type": "string", "minLength": 1},
        "maximumSize": {"type": "string", "pattern": "^[1-9][0-9]*(MB|GB)$"}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directories"],
      "properties": {
        "directories": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "sources": {"type": "array"},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "enabled"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["ama-spool", "azure-logs-ingestion"]},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "routing": {"type": "array"},
    "health": {"type": "object"},
    "logging": {"type": "object"}
  }
}
