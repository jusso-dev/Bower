<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the security pins below override vulnerable transitive versions. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.1.1" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.1.0.2" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.21" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.Ingestion" Version="1.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <!-- Azure Functions isolated worker (Bower.Functions.Collector only). -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <!-- Bower.Sdk net10.0 build only; .NET 11 ships it in the shared framework. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <!-- Collector only: runs as a Windows service under the MSI (no-op elsewhere). -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <!-- Also lifts JwtBearer's IdentityModel (its floor is 8.19.2) through transitive pinning;
         the Functions collector validates Entra tokens with them directly. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Aspire local harness only (Bower.ServiceDefaults, Bower.AppHost, Bower.AppHost.Tests);
         see docs/architecture/dependencies.md. Never shipped in a production image or package
         except ServiceDefaults, which is inert without OTEL_EXPORTER_OTLP_ENDPOINT. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="17.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <!-- Security pin: Microsoft.Data.SqlClient 7.1.1 pulls 9.0.18, which has known
         moderate and high advisories (NU1902/NU1903). Pinned to the shared framework train (11.0.0). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
