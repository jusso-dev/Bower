{
  "version": "1.0", "format": "Json",
  "fields": [
    {"sourceName":"id","type":"Text","ocsfPath":"metadata.uid","asimField":"EventUid","sensitive":false},
    {"sourceName":"timestamp","type":"DateTime","ocsfPath":"time","asimField":"TimeGenerated","sensitive":false},
    {"sourceName":"appName","type":"Text","ocsfPath":"app.name","asimField":"DvcAppName","sensitive":false},
    {"sourceName":"message","type":"Text","ocsfPath":"message","asimField":"EventMessage","sensitive":true},
    {"sourceName":"result","type":"Text","ocsfPath":"status","asimField":"EventResult","sensitive":true},
    {"sourceName":"source_ip","type":"IpAddress","ocsfPath":"src_endpoint.ip","asimField":"SrcIpAddr","sensitive":true},
    {"sourceName":"sequence","type":"Text","ocsfPath":"metadata.correlation_uid","asimField":"EventOriginalUid","sensitive":true},
    {"sourceName":"reason","type":"Text","ocsfPath":"status_detail","asimField":"EventResultDetails","sensitive":false}
  ],
  "runtime": {
    "applicationName":"storage-pressure-sender","environment":"validation",
    "eventCategory":"network-security","eventType":"network_connection_denied",
    "eventAction":"network.connect","eventResult":"denied",
    "transforms":[
      ".m = regex_extract(.message, 'BOWER_SEQ seq=(?<seq>ws3[ls][0-9]{7}) src=(?<ip>[0-9.]+)')",
      "if .appName == \"bowerseq\" && .m.seq != null { .result = \"deny\" } else { .result = \"ignored\" }",
      ".sequence = .m.seq", ".source_ip = .m.ip", ".reason = \"SequenceProbe\"", "del(.m)"
    ],
    "match":{"result":"deny"},
    "fields":{"eventId":"id","timeGenerated":"timestamp","source.ipAddress":"source_ip","request.correlationId":"sequence","eventOutcomeReason":"reason"}
  }
}
